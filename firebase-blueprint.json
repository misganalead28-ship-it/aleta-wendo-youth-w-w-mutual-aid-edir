{
  "entities": {
    "UserAccount": {
      "title": "UserAccount",
      "description": "Registered Edir member or committee officer account with role, residence status, portal access, and dues balances.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 2, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "authUid": { "type": "string", "maxLength": 128 },
        "role": {
          "type": "string",
          "enum": ["member", "vice_chair", "chairperson", "secretary", "cashier", "pr", "auditor"]
        },
        "fullNameAm": { "type": "string", "minLength": 1, "maxLength": 160 },
        "fullNameEn": { "type": "string", "minLength": 1, "maxLength": 160 },
        "roleTitleAm": { "type": "string", "maxLength": 160 },
        "roleTitleEn": { "type": "string", "maxLength": 160 },
        "phone": { "type": "string", "maxLength": 40 },
        "email": { "type": "string", "minLength": 3, "maxLength": 180 },
        "passwordHash": { "type": "string", "maxLength": 128 },
        "city": { "type": "string", "maxLength": 100 },
        "country": { "type": "string", "maxLength": 100 },
        "addressDetail": { "type": "string", "maxLength": 250 },
        "residenceType": { "type": "string", "enum": ["local", "out_of_town"] },
        "joinDate": { "type": "string", "maxLength": 32 },
        "bloodType": { "type": "string", "maxLength": 10 },
        "emergencyContactName": { "type": "string", "maxLength": 160 },
        "emergencyContactPhone": { "type": "string", "maxLength": 40 },
        "photoUrl": { "type": "string", "maxLength": 512 },
        "status": { "type": "string", "enum": ["active", "pending_chair", "suspended"] },
        "portalAccessEnabled": { "type": "boolean" },
        "monthlyDueBalance": { "type": "number" },
        "penaltyBalance": { "type": "number" },
        "specialDueBalance": { "type": "number" },
        "totalPaidEtb": { "type": "number" },
        "lastPaidMonth": { "type": "string", "maxLength": 32 },
        "beneficiaries": { "type": "array" },
        "committeeEmails": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "role",
        "fullNameAm",
        "fullNameEn",
        "email",
        "residenceType",
        "status",
        "portalAccessEnabled",
        "monthlyDueBalance",
        "penaltyBalance",
        "specialDueBalance",
        "totalPaidEtb",
        "beneficiaries",
        "committeeEmails",
        "createdAt",
        "updatedAt"
      ]
    },
    "CommitteeRosterEntry": {
      "title": "CommitteeRosterEntry",
      "description": "Trusted committee role mapping keyed by lowercase email for server-verified RBAC in rules.",
      "type": "object",
      "properties": {
        "email": { "type": "string", "minLength": 3, "maxLength": 180 },
        "role": {
          "type": "string",
          "enum": ["vice_chair", "chairperson", "secretary", "cashier", "pr", "auditor"]
        },
        "active": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "role", "active", "updatedAt"]
    },
    "PaymentTransaction": {
      "title": "PaymentTransaction",
      "description": "Member payment receipt submission and cashier verification record.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 2, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "memberId": { "type": "string", "minLength": 2, "maxLength": 128 },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "memberEmail": { "type": "string", "maxLength": 180 },
        "memberNameAm": { "type": "string", "maxLength": 160 },
        "memberNameEn": { "type": "string", "maxLength": 160 },
        "type": { "type": "string", "enum": ["monthly_dues", "penalty_settlement", "special_campaign", "combined"] },
        "itemLabelsEn": { "type": "string", "maxLength": 300 },
        "itemLabelsAm": { "type": "string", "maxLength": 300 },
        "amount": { "type": "number" },
        "method": { "type": "string", "enum": ["Telebirr", "CBE Birr", "CBE Bank Transfer", "Awash Bank"] },
        "referenceNumber": { "type": "string", "minLength": 1, "maxLength": 120 },
        "paymentDate": { "type": "string", "maxLength": 32 },
        "submittedDate": { "type": "string", "maxLength": 32 },
        "receiptFileName": { "type": "string", "maxLength": 200 },
        "receiptPreviewType": { "type": "string", "enum": ["image", "pdf"] },
        "receiptDataUrl": { "type": "string", "maxLength": 350000 },
        "status": { "type": "string", "enum": ["pending_verification", "verified", "rejected"] },
        "rejectionReasonAm": { "type": "string", "maxLength": 400 },
        "rejectionReasonEn": { "type": "string", "maxLength": 400 },
        "verifiedBy": { "type": "string", "maxLength": 160 },
        "committeeEmails": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "memberId",
        "ownerUid",
        "memberEmail",
        "amount",
        "method",
        "referenceNumber",
        "status",
        "committeeEmails",
        "createdAt",
        "updatedAt"
      ]
    },
    "MemberRequest": {
      "title": "MemberRequest",
      "description": "Member asset rental, benefit claim, profile update, or general inquiry.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 2, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "memberId": { "type": "string", "minLength": 2, "maxLength": 128 },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "memberEmail": { "type": "string", "maxLength": 180 },
        "memberNameAm": { "type": "string", "maxLength": 160 },
        "memberNameEn": { "type": "string", "maxLength": 160 },
        "requestType": { "type": "string", "enum": ["asset_rental", "benefit_claim", "profile_update", "general_inquiry"] },
        "titleAm": { "type": "string", "minLength": 1, "maxLength": 200 },
        "titleEn": { "type": "string", "minLength": 1, "maxLength": 200 },
        "description": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "requestedDate": { "type": "string", "maxLength": 32 },
        "requestedAmountEtb": { "type": "number" },
        "attachmentName": { "type": "string", "maxLength": 200 },
        "submittedDate": { "type": "string", "maxLength": 32 },
        "status": {
          "type": "string",
          "enum": ["pending_vice_chair", "pending_chair", "pending_cashier", "approved", "disbursed", "rejected"]
        },
        "committeeResponseAm": { "type": "string", "maxLength": 500 },
        "committeeResponseEn": { "type": "string", "maxLength": 500 },
        "committeeEmails": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "memberId",
        "ownerUid",
        "memberEmail",
        "requestType",
        "titleAm",
        "titleEn",
        "description",
        "status",
        "committeeEmails",
        "createdAt",
        "updatedAt"
      ]
    },
    "SpecialCampaign": {
      "title": "SpecialCampaign",
      "description": "Edir special contribution campaign.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 2, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "orgId": { "type": "string", "maxLength": 64 },
        "titleAm": { "type": "string", "maxLength": 200 },
        "titleEn": { "type": "string", "maxLength": 200 },
        "category": { "type": "string", "enum": ["wedding", "bereavement", "asset_purchase", "medical", "other"] },
        "contributionMode": { "type": "string", "enum": ["fixed", "voluntary"] },
        "targetAmountPerMember": { "type": "number" },
        "totalGoal": { "type": "number" },
        "collectedAmount": { "type": "number" },
        "deadline": { "type": "string", "maxLength": 32 },
        "status": { "type": "string", "enum": ["active", "closed"] },
        "descriptionAm": { "type": "string", "maxLength": 1000 },
        "descriptionEn": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "orgId", "titleAm", "titleEn", "status", "createdAt", "updatedAt"]
    },
    "Meeting": {
      "title": "Meeting",
      "description": "Edir assembly meeting with QR check-in token.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 2, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "orgId": { "type": "string", "maxLength": 64 },
        "titleAm": { "type": "string", "maxLength": 200 },
        "titleEn": { "type": "string", "maxLength": 200 },
        "date": { "type": "string", "maxLength": 32 },
        "time": { "type": "string", "maxLength": 64 },
        "locationAm": { "type": "string", "maxLength": 200 },
        "locationEn": { "type": "string", "maxLength": 200 },
        "agendaAm": { "type": "string", "maxLength": 2000 },
        "agendaEn": { "type": "string", "maxLength": 2000 },
        "qrToken": { "type": "string", "maxLength": 128 },
        "status": { "type": "string", "enum": ["live", "upcoming", "completed"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "orgId", "titleAm", "titleEn", "date", "qrToken", "status", "createdAt", "updatedAt"]
    },
    "MeetingAttendance": {
      "title": "MeetingAttendance",
      "description": "Individual member attendance record inside a meeting subcollection.",
      "type": "object",
      "properties": {
        "memberId": { "type": "string", "minLength": 2, "maxLength": 128 },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "status": { "type": "string", "enum": ["present", "geo_exempt", "absent"] },
        "checkedInAt": { "type": "string", "maxLength": 64 },
        "method": { "type": "string", "enum": ["qr_scan", "auto_geo"] },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["memberId", "ownerUid", "status", "updatedAt"]
    },
    "EdirRecordDoc": {
      "title": "EdirRecordDoc",
      "description": "Official Edir bylaw, meeting minutes, financial sheet, member sheet, or policy.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 2, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "orgId": { "type": "string", "maxLength": 64 },
        "recordType": { "type": "string", "enum": ["bylaw", "minutes", "policy", "financial_sheet", "member_sheet"] },
        "code": { "type": "string", "maxLength": 100 },
        "titleAm": { "type": "string", "maxLength": 200 },
        "titleEn": { "type": "string", "maxLength": 200 },
        "date": { "type": "string", "maxLength": 32 },
        "author": { "type": "string", "maxLength": 160 },
        "summaryAm": { "type": "string", "maxLength": 500 },
        "summaryEn": { "type": "string", "maxLength": 500 },
        "contentAm": { "type": "string", "maxLength": 20000 },
        "contentEn": { "type": "string", "maxLength": 20000 },
        "attachedFileName": { "type": "string", "maxLength": 200 },
        "attachedFileSize": { "type": "string", "maxLength": 40 },
        "attachedDataUrl": { "type": "string", "maxLength": 450000 },
        "importedRowCount": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "orgId", "recordType", "code", "titleAm", "titleEn", "date", "createdAt", "updatedAt"]
    },
    "CommitteeMessage": {
      "title": "CommitteeMessage",
      "description": "Official announcement published to member inbox.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 2, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "orgId": { "type": "string", "maxLength": 64 },
        "category": { "type": "string", "enum": ["urgent", "meetings", "payments", "general"] },
        "titleAm": { "type": "string", "maxLength": 200 },
        "titleEn": { "type": "string", "maxLength": 200 },
        "bodyAm": { "type": "string", "maxLength": 2000 },
        "bodyEn": { "type": "string", "maxLength": 2000 },
        "senderAm": { "type": "string", "maxLength": 160 },
        "senderEn": { "type": "string", "maxLength": 160 },
        "date": { "type": "string", "maxLength": 32 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "orgId", "category", "titleAm", "titleEn", "bodyAm", "bodyEn", "date", "createdAt"]
    },
    "AssetItem": {
      "title": "AssetItem",
      "description": "Physical Edir asset inventory item.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 2, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "orgId": { "type": "string", "maxLength": 64 },
        "nameAm": { "type": "string", "maxLength": 200 },
        "nameEn": { "type": "string", "maxLength": 200 },
        "category": { "type": "string", "enum": ["tent", "chair", "utensil", "electronics"] },
        "totalQuantity": { "type": "number" },
        "availableQuantity": { "type": "number" },
        "dailyRentalFeeEtb": { "type": "number" },
        "condition": { "type": "string", "enum": ["good", "fair"] },
        "storageLocation": { "type": "string", "maxLength": 200 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "orgId", "nameAm", "nameEn", "totalQuantity", "availableQuantity", "updatedAt"]
    },
    "Directive": {
      "title": "Directive",
      "description": "Executive committee directive assigned by Chairperson.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 2, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "orgId": { "type": "string", "maxLength": 64 },
        "titleAm": { "type": "string", "maxLength": 200 },
        "titleEn": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 1000 },
        "assignedToRole": {
          "type": "string",
          "enum": ["member", "vice_chair", "chairperson", "secretary", "cashier", "pr", "auditor"]
        },
        "dueDate": { "type": "string", "maxLength": 32 },
        "status": { "type": "string", "enum": ["assigned", "in_progress", "completed"] },
        "issuedBy": { "type": "string", "maxLength": 160 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "orgId", "titleAm", "titleEn", "assignedToRole", "status", "createdAt", "updatedAt"]
    },
    "AuditLogEntry": {
      "title": "AuditLogEntry",
      "description": "Immutable operational audit log record.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 2, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "orgId": { "type": "string", "maxLength": 64 },
        "timestamp": { "type": "string", "maxLength": 64 },
        "actorName": { "type": "string", "maxLength": 160 },
        "actorUid": { "type": "string", "maxLength": 128 },
        "actorRole": {
          "type": "string",
          "enum": ["member", "vice_chair", "chairperson", "secretary", "cashier", "pr", "auditor"]
        },
        "action": { "type": "string", "maxLength": 80 },
        "detailsAm": { "type": "string", "maxLength": 500 },
        "detailsEn": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "orgId", "actorUid", "actorRole", "action", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserAccount" },
      "description": "Member and committee user accounts with role, password hash, portal access, and dues balances."
    },
    "/committee_roster/{emailKey}": {
      "schema": { "$ref": "#/entities/CommitteeRosterEntry" },
      "description": "Trusted committee email-to-role map maintained by Vice Chairperson / Admin."
    },
    "/transactions/{txnId}": {
      "schema": { "$ref": "#/entities/PaymentTransaction" },
      "description": "Member receipt submissions and Cashier verification statuses."
    },
    "/requests/{reqId}": {
      "schema": { "$ref": "#/entities/MemberRequest" },
      "description": "Member asset rental, benefit claim, and general requests."
    },
    "/campaigns/{campaignId}": {
      "schema": { "$ref": "#/entities/SpecialCampaign" },
      "description": "Active and closed Edir special contribution campaigns."
    },
    "/meetings/{meetingId}": {
      "schema": { "$ref": "#/entities/Meeting" },
      "description": "Edir assembly meetings and QR check-in tokens."
    },
    "/meetings/{meetingId}/attendance/{memberId}": {
      "schema": { "$ref": "#/entities/MeetingAttendance" },
      "description": "Attendance check-ins for a specific meeting."
    },
    "/records/{recordId}": {
      "schema": { "$ref": "#/entities/EdirRecordDoc" },
      "description": "Official Edir bylaws, meeting minutes, financial sheets, and imported records."
    },
    "/messages/{messageId}": {
      "schema": { "$ref": "#/entities/CommitteeMessage" },
      "description": "Committee announcements published to members."
    },
    "/assets/{assetId}": {
      "schema": { "$ref": "#/entities/AssetItem" },
      "description": "Association equipment inventory."
    },
    "/directives/{directiveId}": {
      "schema": { "$ref": "#/entities/Directive" },
      "description": "Executive directives assigned by Chairperson."
    },
    "/auditLogs/{logId}": {
      "schema": { "$ref": "#/entities/AuditLogEntry" },
      "description": "Immutable activity audit trail."
    }
  }
}
